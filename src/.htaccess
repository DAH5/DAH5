ErrorDocument 404 /404.html
ErrorDocument 418 /teapot/index.html

<IfModule mod_rewrite.c>
    RewriteEngine on

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=307,END]
    
    RewriteCond %{HTTP_HOST} ^dah5\.me\.uk$ [OR]
    RewriteCond %{HTTP_HOST} ^dah5\.com$ [OR]
    RewriteCond %{HTTP_HOST} ^www\.dah5\.com$ [OR]
    RewriteCond %{HTTP_HOST} ^dah5\.co\.uk$ [OR]
    RewriteCond %{HTTP_HOST} ^www\.dah5\.co\.uk$
    RewriteRule ^(.*)$ https://www.dah5.me.uk/$1 [R=307,END]

	RewriteCond %{HTTP_HOST} ^(?!www\.)(.+)\.dah5\.com$ [OR]
    RewriteCond %{HTTP_HOST} ^(?!www\.)(.+)\.dah5\.co\.uk$
    RewriteRule ^(.*)$ https://%1.dah5.me.uk/$1 [R=307,END]

    RewriteCond %{HTTP_HOST} ^(?!www\.)(.+)\.dah5\.me\.uk$
	RewriteRule ^(.*)$ https://www.dah5.me.uk/%1/$1 [R=307,END]

    RewriteRule ^teapot/?$ - [R=418,END]
</IfModule>
